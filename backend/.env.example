# Production deployment ke liye yeh values set karo (Render/Railway dashboard
# ke "Environment Variables" section mein, ya server pe export karo).
# Yeh .env file khud commit/upload NAHI karni — sirf reference ke liye hai.

# Random secret string — kabhi bhi default fallback production mein use na karo.
# Generate karne ke liye terminal mein: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=apna_yahan_random_secret_daalo

# Local development database (pgAdmin se banaya gaya blood_db):
DATABASE_URL=postgresql://postgres:Admin@123@localhost:5432/blood_db

# Production (Render/Railway) mein apna hosted PostgreSQL URL yahan daalo,
# usi naam (DATABASE_URL) ke env var ke through — local wala hardcode
# value production mein use NAHI hogi agar env var set kar diya jaye.
